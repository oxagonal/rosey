# Rosey: link the Jetson to the Render control server at boot.
# Install with: sudo bash ~/Desktop/rosey/install_service.sh
[Unit]
Description=Rosey robot agent (motors + Render control server link)
After=network-online.target
Wants=network-online.target

[Service]
User=henry
WorkingDirectory=/home/henry/Desktop/rosey
EnvironmentFile=/home/henry/Desktop/rosey/agent.env
Environment=PYTHONUNBUFFERED=1
# "+" runs this one step as root: un-tristate the motor pins (lost on every reboot).
ExecStartPre=+/usr/bin/python3 /home/henry/Desktop/rosey/pinmux_fix.py
ExecStart=/usr/bin/python3 /home/henry/Desktop/rosey/run_agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
