# Rosey: link the Jetson to the Render control server at boot.
# Install with: sudo bash ~/Desktop/rosey/install_boot.sh
[Unit]
Description=Rosey robot agent (motors + Render control server link)
# user@1000 = henry's user session, which runs PulseAudio (speaker + mic). Starting it
# here means audio works at boot with nobody logged in and no screen attached.
After=network-online.target bluetooth.service user@1000.service
Wants=network-online.target bluetooth.service user@1000.service

[Service]
User=henry
WorkingDirectory=/home/henry/Desktop/rosey
EnvironmentFile=/home/henry/Desktop/rosey/agent.env
Environment=PYTHONUNBUFFERED=1
# "+" runs this one step as root: un-tristate the motor pins (lost on every reboot).
ExecStartPre=+/usr/bin/python3 /home/henry/Desktop/rosey/pinmux_fix.py
ExecStart=/usr/bin/python3 /home/henry/Desktop/rosey/run_agent.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
