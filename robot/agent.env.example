ROSEY_SERVER=https://rosey-control.onrender.com
ROBOT_TOKEN=paste-ROBOT_TOKEN-from-the-Render-dashboard
# ROSEY_MAX_SPEED=0.8
ANTHROPIC_API_KEY=paste-your-Anthropic-API-key
# USB mic (PulseAudio source name; `pactl list short sources`)
# ROSEY_MIC=alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-mono
# Voice loudness: speech stream level 0-100 and compression 0-5 (more = louder, harsher).
# Overall volume is the JLab output slider in Ubuntu / the website slider.
ROSEY_TTS_VOLUME=100
ROSEY_TTS_DRIVE=3
# Claude models: replies (fast) and fall/camera checks (accurate).
# ROSEY_REPLY_MODEL=claude-sonnet-5-5
# ROSEY_CLAUDE_MODEL=claude-opus-5-5
# Phone alerts via ntfy: a private, hard-to-guess topic name.
# ROSEY_NTFY_TOPIC=rosey-your-private-topic
