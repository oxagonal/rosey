# Copy to /etc/rosey/agent.env (sudo), fill in, then: sudo chmod 600 /etc/rosey/agent.env
ROSEY_SERVER=https://rosey-control.onrender.com
ROBOT_TOKEN=paste-ROBOT_TOKEN-from-the-Render-dashboard

# Optional
# ROSEY_NAME=rosey
# ROSEY_INVERT_LEFT=1       # if the left wheel runs backwards (see motor_test)
# ROSEY_INVERT_RIGHT=1
# ROSEY_MIN_DUTY=35         # lowest PWM % that moves the wheels
# ROSEY_MAX_SPEED=0.8       # cap top speed
# ROSEY_MYO_UDP=5006        # forward Myo fall alerts from myo-fall-detect
